pipeline {
    agent any

    parameters {
        string(name: 'DEPLOY_PORT', defaultValue: '8081',
               description: 'Port the deployed app listens on')
        string(name: 'DB_URL', defaultValue: 'jdbc:mysql://localhost:3306/machine_maintenance',
               description: 'JDBC URL the deployed app connects to')
    }

    environment {
        APP_DIR    = 'machine-maintenance-portal_new'
        DEPLOY_DIR = 'C:/deploy/machine-portal'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir("${env.APP_DIR}") {
                    bat 'mvnw.cmd -B clean compile'
                }
            }
        }

        stage('Package') {
            steps {
                dir("${env.APP_DIR}") {
                    bat 'mvnw.cmd -B package'
                }
                archiveArtifacts artifacts: "${env.APP_DIR}/target/*.jar", fingerprint: true
            }
        }

         stage('Deploy') {
            steps {
                powershell '''
                    $deployDir = ($env:DEPLOY_DIR -replace '/', '\\')
                    $port = [int]$env:APP_PORT
                    New-Item -ItemType Directory -Force -Path $deployDir | Out-Null

                    # 1. Stop the old version if it is running on this port
                    $old = Get-NetTCPConnection -LocalPort $port -State Listen -ErrorAction SilentlyContinue
                    if ($old) {
                        $old | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }
                        Start-Sleep -Seconds 3
                    }

                    # 2. Copy the new jar into the deploy folder
                    $jar = Get-ChildItem "$env:WORKSPACE/$env:APP_DIR/target/*.jar" | Where-Object { $_.Name -notlike "*.original" } | Select-Object -First 1
                    Copy-Item $jar.FullName "$deployDir\\machine-portal.jar" -Force

                    # 3. Write the start script
                    if ($env:JAVA_HOME) { $javaExe = "$env:JAVA_HOME\\bin\\java.exe" } else { $javaExe = (Get-Command java).Source }
                    $lines = @(
                        "@echo off",
                        "cd /d `"$deployDir`"",
                        "set DB_URL=$env:DB_URL",
                        "`"$javaExe`" -jar `"$deployDir\\machine-portal.jar`" --server.port=$port > `"$deployDir\\app.log`" 2>&1"
                    )
                    Set-Content -Path "$deployDir\\run.bat" -Value $lines -Encoding ASCII

                    # 4. Register and start a Windows Scheduled Task (runs independently of Jenkins)
                    $taskName = "MachinePortal-$port"
                    & schtasks.exe /Create /TN $taskName /TR "$deployDir\\run.bat" /SC ONSTART /RU SYSTEM /RL HIGHEST /F | Out-Null
                    if ($LASTEXITCODE -ne 0) { Write-Host "Could not create scheduled task"; exit 1 }
                    & schtasks.exe /Run /TN $taskName | Out-Null
                    if ($LASTEXITCODE -ne 0) { Write-Host "Could not start scheduled task"; exit 1 }

                    Write-Host "Started application on port $port using DB $env:DB_URL"
                '''
            }
        }
        stage('Health Check') {
            steps {
                powershell '''
                    $url = "http://localhost:$($env:DEPLOY_PORT)/login"
                    $ok = $false
                    for ($i = 1; $i -le 30; $i++) {
                        try {
                            $r = Invoke-WebRequest -Uri $url -UseBasicParsing -TimeoutSec 3
                            if ($r.StatusCode -eq 200) { $ok = $true; break }
                        } catch { Start-Sleep -Seconds 3 }
                    }
                    if (-not $ok) { Write-Host "Application did not start in time"; exit 1 }
                    Write-Host "Application is UP at $url"
                '''
            }
        }
    }

    post {
        always {
            junit testResults: "${env.APP_DIR}/target/surefire-reports/*.xml", allowEmptyResults: true
        }
    }
}